# ==============================
# Clinixa Client — Environment Variables
# انسخ الملف ده إلى .env وحط القيم الحقيقية بتاعتك
#
# ⚠️ Vite بيقرا بس المتغيرات اللي بادئة بـ VITE_ ويحطها في import.meta.env
# أي متغير من غير البادئة دي مش هيوصل للفرونت خالص (حماية من تسريب أسرار بالغلط)
# ==============================

# ---- عنوان الباك إند المحلي (Express جوه Electron) ----
VITE_API_BASE_URL=http://localhost:4321/api

# ---- تفعيل الـ Mock API (MSW) وقت التطوير ----
# true = يشتغل بدون سيرفر حقيقي (يستخدم الأمثلة من clinixa-api-reference.md)
# false = يكلم السيرفر الحقيقي على VITE_API_BASE_URL
VITE_ENABLE_MOCKS=true

# ---- بيئة التشغيل ----
VITE_APP_ENV=development

# ---- اللغة الافتراضية ----
VITE_DEFAULT_LOCALE=ar
